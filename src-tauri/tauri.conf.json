{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitPulse",
  "version": "0.8.0",
  "identifier": "dev.gitpulse.workflowmonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GitPulse",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0B0C0E",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/n4od/GitPulse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMDM0ODMyRkUyNTQwMkEKUldRcVFDWCtNa2dEKy9lOWIvRmlGM1M2dXNrT21IT3NmcDFoajd2eVFZZnlGekxtQmhWYlhDREwK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "Monitor GitHub workflows locally",
    "longDescription": "GitPulse watches GitHub Actions workflows, deployments and pull requests across your repositories, entirely on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
